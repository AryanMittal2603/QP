{
  "name": "upessc-qpr-desktop",
  "productName": "UPESSC QPR",
  "version": "3.0.0",
  "description": "UPESSC Question Paper Randomization: Windows app that works on its own on one computer (logins, exams, randomization, results, certificates)",
  "author": "UPESSC",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node build/prepare.js",
    "start": "node build/prepare.js && electron .",
    "dist": "node build/prepare.js && node build/dist.js"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.17.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "in.upessc.qpr",
    "productName": "UPESSC QPR",
    "artifactName": "UPESSC-QPR-Setup-${version}.exe",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "local-db.mjs",
      "app/**/*",
      "package.json",
      "!node_modules/@electric-sql/pglite/dist/*.tar.gz",
      "!node_modules/@electric-sql/pglite/dist/**/*.map",
      "!node_modules/@electric-sql/pglite/dist/**/*.d.ts",
      "!node_modules/@electric-sql/pglite/dist/**/*.d.cts",
      "!build/**"
    ],
    "asar": true,
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/dist/*.wasm",
      "node_modules/@electric-sql/pglite/dist/*.data"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "UPESSC QPR",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "UPESSC QPR"
    },
    "publish": null
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
